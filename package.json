{
  "name": "epc-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:EPC-Frontend": "node dist/epc-frontend/server/server.mjs",
    "deploy:prepare": "npm run build && npm run deploy:copy && npm run deploy:config && npm run deploy:mail-backend",
    "deploy:copy": "xcopy \"dist\\epc-frontend\\browser\\*\" \"deploy-ionos\\\" /E /Y",
    "deploy:config": "copy \".htaccess\" \"deploy-ionos\\.htaccess\" && copy \"deploy-ionos\\index.csr.html\" \"deploy-ionos\\index.html\"",
    "deploy:mail-backend": "if not exist \"deploy-ionos\\mail-backend\" mkdir \"deploy-ionos\\mail-backend\" && copy \"mail-backend\\send-email-with-templates.php\" \"deploy-ionos\\mail-backend\\\" && copy \"mail-backend\\quote-template.html\" \"deploy-ionos\\mail-backend\\\" && copy \"mail-backend\\quote-template-pdf.html\" \"deploy-ionos\\mail-backend\\\"",
    "deploy:clean": "rmdir /s /q deploy-ionos && mkdir deploy-ionos"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/cdk": "^17.0.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/localize": "^18.2.13",
    "@angular/material": "^17.0.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/platform-server": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@angular/ssr": "^18.2.12",
    "@ng-bootstrap/ng-bootstrap": "^17.0.1",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "express": "^4.18.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "lucide-angular": "^0.475.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.12",
    "@angular/cli": "^18.2.12",
    "@angular/compiler-cli": "^18.2.0",
    "@eslint/js": "^9.16.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.5.2",
    "typescript-eslint": "^8.17.0"
  }
}
